{%- liquid
  assign align = section.settings.content_position
  assign justify = 'center'
  assign placement = ''
  if align == 'left'
    assign justify = 'start'
    assign placement = ' banner__content--start'
  elsif align == 'right'
    assign justify = 'end'
    assign placement = ' banner__content--end'
  endif
-%}

<div
  class="banner color-{{ section.settings.color_scheme }} color-scheme"
  style="
    --banner-height: {{ section.settings.height }}vh;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-justify: {{ justify }};
    --content-align: {{ align }};
  "
>
  <div class="banner__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1500x'
      }}
    {%- elsif section.settings.image != blank or section.settings.image_mobile != blank -%}
      {%- assign desktop_image_class = '' -%}
      {%- if section.settings.image_mobile != blank -%}
        {%- assign desktop_image_class = 'banner__image--desktop' -%}
      {%- endif -%}
      {%- assign mobile_image_class = 'banner__image--mobile' -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" class="banner__image--mobile" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2880
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: desktop_image_class,
              widths: '750, 1100, 1500, 2000, 2400, 2880',
              sizes: '100vw',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{
            section.settings.image_mobile
            | image_url: width: 1500
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: mobile_image_class,
              widths: '375, 550, 750, 1100, 1500',
              sizes: '100vw',
              alt: section.settings.image_mobile.alt
          }}
        {%- endif -%}
      </picture>
    {%- else -%}
      <img
        src="{{ 'hero-banner.jpg' | asset_url }}"
        alt="Dose & Dial Espresso Bar"
        loading="eager"
        fetchpriority="high"
        width="2880"
        height="1620"
        sizes="100vw"
        style="width: 100%; height: 100%; object-fit: cover;"
      >
    {%- endif -%}
  </div>

  <div class="page-width">
    <div class="banner__content{{ placement }}{% if section.settings.boxed %} banner__content--boxed{% endif %}" data-animate>
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero.settings.image_mobile.label"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.hero.settings.video.label",
      "info": "t:sections.hero.settings.video.info"
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.hero.settings.height.label",
      "default": 85
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:sections.hero.settings.overlay_opacity.label",
      "default": 30
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.hero.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero.settings.content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.hero.settings.content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.hero.settings.content_position.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "boxed",
      "label": "t:sections.hero.settings.boxed.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero.settings.color_scheme.label",
      "default": "scheme_3",
      "info": "t:sections.hero.settings.color_scheme.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.preset__1.name",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<p class=\"eyebrow\">DOSE • DIAL • BREW</p>",
            "alignment": "center"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "PRECISION FOR EVERY POUR.",
            "size": "h0",
            "alignment": "center"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Premium tools for home baristas who take every shot seriously.</p>",
            "alignment": "center"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "SHOP ESPRESSO TOOLS",
            "link": "/collections/espresso-tools",
            "style": "solid",
            "alignment": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
