<div class="rte{% if block.settings.style == 'eyebrow' %} eyebrow{% endif %}" style="text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.settings.text.label",
      "default": "<p>Share what makes this product different.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "eyebrow", "label": "Eyebrow" }
      ],
      "default": "body"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.text.settings.alignment.label",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.text.presets.preset__1.name"
    }
  ]
}
{% endschema %}
