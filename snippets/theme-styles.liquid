{%- comment -%}
  Design tokens. Everything the stylesheet consumes is declared here from theme
  settings, so the whole theme can be restyled from the editor.
{%- endcomment -%}

{%- liquid
  assign heading_font = settings.heading_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
  assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
  assign body_font = settings.body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bolder'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
-%}

{%- if heading_font != blank -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ heading_font_italic | font_face: font_display: 'swap' }}
  {{ heading_font_bold_italic | font_face: font_display: 'swap' }}
{%- endif -%}
{%- if body_font != blank -%}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}
{%- endif -%}

{%- comment -%}
  Dose & Dial Color Schemes:
  - scheme_1: Soft Off-White (#FCFAF6) Storefront Default
  - scheme_2: Warm Cream (#F7F3EB) Editorial
  - scheme_3: Matte Black / Deep Espresso (#111111) Announcement & Dark Accent
  - scheme_4: Deep Espresso (#2A1D17) Ritual Workflow
{%- endcomment -%}

{%- for scheme in settings.color_schemes -%}
  {%- liquid
    assign bg = scheme.settings.background | default: '#0B0C0E'
    assign text = scheme.settings.text | default: '#F3F4F6'
    assign button = scheme.settings.button | default: '#E5A968'
    assign button_label = scheme.settings.button_label | default: '#0B0C0E'
    assign outline_button = scheme.settings.outline_button | default: button
    assign accent = scheme.settings.accent | default: '#E5A968'
    assign border = scheme.settings.border | default: '#22242C'
  -%}
  {% if forloop.first %}:root, {% endif %}.color-{{ scheme.id }}, .color-{{ scheme.id | replace: '_', '-' }} {
    --color-background: {{ bg | color_extract: 'red' }} {{ bg | color_extract: 'green' }} {{ bg | color_extract: 'blue' }};
    --color-text: {{ text | color_extract: 'red' }} {{ text | color_extract: 'green' }} {{ text | color_extract: 'blue' }};
    --color-button: {{ button | color_extract: 'red' }} {{ button | color_extract: 'green' }} {{ button | color_extract: 'blue' }};
    --color-button-label: {{ button_label | color_extract: 'red' }} {{ button_label | color_extract: 'green' }} {{ button_label | color_extract: 'blue' }};
    --color-outline-button: {{ outline_button | color_extract: 'red' }} {{ outline_button | color_extract: 'green' }} {{ outline_button | color_extract: 'blue' }};
    --color-accent: {{ accent | color_extract: 'red' }} {{ accent | color_extract: 'green' }} {{ accent | color_extract: 'blue' }};
    --color-border: {{ border | color_extract: 'red' }} {{ border | color_extract: 'green' }} {{ border | color_extract: 'blue' }};
    {% if scheme.settings.background_gradient != blank %}--gradient-background: {{ scheme.settings.background_gradient }};{% else %}--gradient-background: none;{% endif %}
  }
{%- endfor -%}

.color-scheme {
  color: rgb(var(--color-text));
  background-color: rgb(var(--color-background));
  background-image: var(--gradient-background);
}

:root {
  /* Dose & Dial Futuristic Stealth Palette Tokens */
  --color-brand-obsidian: 11 12 14;
  --color-brand-slate: 19 21 26;
  --color-brand-onyx: 7 7 9;
  --color-brand-titanium: 243 244 246;
  --color-brand-amber: 229 169 104;
  --color-brand-amber-glow: 245 158 11;
  --color-brand-steel: 156 163 175;
  --color-brand-border: 34 36 44;

  /* Dose & Dial Futuristic Hex Values */
  --color-brand-obsidian-hex: #0B0C0E;
  --color-brand-slate-hex: #13151A;
  --color-brand-onyx-hex: #070709;
  --color-brand-titanium-hex: #F3F4F6;
  --color-brand-amber-hex: #E5A968;
  --color-brand-steel-hex: #9CA3AF;
  --color-brand-border-hex: #22242C;

  /* Legacy brand tokens mapped to futuristic palette */
  --color-brand-cream: var(--color-brand-obsidian);
  --color-brand-offwhite: var(--color-brand-slate);
  --color-brand-white: var(--color-brand-titanium);
  --color-brand-black: var(--color-brand-onyx);
  --color-brand-espresso: 22 19 17;
  --color-brand-walnut: 40 33 28;
  --color-brand-copper: var(--color-brand-amber);
  --color-brand-taupe: var(--color-brand-border);
  --color-brand-gray: var(--color-brand-steel);

  --color-brand-cream-hex: #0B0C0E;
  --color-brand-offwhite-hex: #13151A;
  --color-brand-white-hex: #F3F4F6;
  --color-brand-black-hex: #070709;
  --color-brand-espresso-hex: #161311;
  --color-brand-walnut-hex: #28211C;
  --color-brand-copper-hex: #E5A968;
  --color-brand-taupe-hex: #22242C;
  --color-brand-gray-hex: #9CA3AF;

  --color-text-secondary: var(--color-brand-steel);

  --font-body: {%- if body_font != blank and body_font.family != blank -%}{{ body_font.family }}, {%- endif -%}'Manrope', 'Inter', {%- if body_font != blank and body_font.fallback_families != blank -%}{{ body_font.fallback_families }}, {%- endif -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-body-weight: {{ body_font.weight | default: 400 }};
  --font-body-style: {{ body_font.style | default: 'normal' }};
  --font-heading: {%- if heading_font != blank and heading_font.family != blank -%}{{ heading_font.family }}, {%- endif -%}'Manrope', 'Inter', {%- if heading_font != blank and heading_font.fallback_families != blank -%}{{ heading_font.fallback_families }}, {%- endif -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-heading-weight: {{ heading_font.weight | default: 600 }};
  --font-heading-style: {{ heading_font.style | default: 'normal' }};

  --line-height-body: 1.6;
  --line-height-heading: 1.15;

  --heading-tracking: {{ settings.heading_tracking | default: 2 | divided_by: 100.0 }}em;
  --heading-case: {{ settings.heading_case | default: 'uppercase' }};
  --body-tracking: {{ settings.body_tracking | default: 0 | divided_by: 100.0 }}em;

  {%- assign hs = settings.heading_scale | default: 100 | divided_by: 100.0 -%}
  {%- assign bs = settings.body_scale | default: 100 | divided_by: 100.0 -%}

  --text-xs: {{ 0.75 | times: bs }}rem;
  --text-sm: {{ 0.875 | times: bs }}rem;
  --text-base: {{ 1.0 | times: bs }}rem;
  --text-lg: {{ 1.125 | times: bs }}rem;

  --text-h0: clamp({{ 2.5 | times: hs }}rem, {{ 6 | times: hs }}vw, {{ 5.5 | times: hs }}rem);
  --text-h1: clamp({{ 2.0 | times: hs }}rem, {{ 4.5 | times: hs }}vw, {{ 3.5 | times: hs }}rem);
  --text-h2: clamp({{ 1.6 | times: hs }}rem, {{ 3.2 | times: hs }}vw, {{ 2.5 | times: hs }}rem);
  --text-h3: {{ 1.5 | times: hs }}rem;
  --text-h4: {{ 1.25 | times: hs }}rem;
  --text-h5: {{ 1.125 | times: hs }}rem;
  --text-h6: {{ 1.0 | times: hs }}rem;

  --page-width: {{ settings.page_width | default: 1440 }}px;
  --page-gutter: 1.25rem;
  --section-gap: {{ settings.spacing_sections | default: 24 }}px;

  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.5rem;
  --space-lg: 2.5rem;
  --space-xl: 4rem;
  --space-2xl: 6rem;
  --section-padding: clamp(2.5rem, 6vw, 5rem);
  --grid-gap: clamp(0.75rem, 2vw, 1.5rem);

  --radius-base: {{ settings.radius_base | default: 4 }}px;
  --radius-media: {{ settings.radius_media | default: 6 }}px;

  --logo-width: {{ settings.logo_width | default: 140 }}px;

  --color-error: 194 61 46;
  --color-success: 42 122 78;
}

@media screen and (min-width: 990px) {
  :root { --page-gutter: 2.5rem; }
}
