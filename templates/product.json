{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "vendor",
          "settings": {}
        },
        "title": {
          "type": "title",
          "settings": {
            "size": "h2"
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_tax_note": true
          }
        },
        "variant-picker": {
          "type": "variant-picker",
          "settings": {
            "style": "swatch"
          }
        },
        "quantity": {
          "type": "quantity",
          "settings": {}
        },
        "buy-buttons": {
          "type": "buy-buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "trust-badges": {
          "type": "trust-badges",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "threshold": 10
          }
        },
        "description": {
          "type": "accordion",
          "settings": {
            "heading": "Description",
            "content": ""
          }
        },
        "whats-included": {
          "type": "accordion",
          "settings": {
            "heading": "What's Included",
            "content": "<p>1x Precision Tool, 1x Care Guide, 1x Certificate of Authenticity.</p>"
          }
        },
        "specifications": {
          "type": "accordion",
          "settings": {
            "heading": "Specifications",
            "content": "<p>Material: Aerospace-grade aluminium, stainless steel, and walnut wood accents. Precision tolerance: ±0.05mm.</p>"
          }
        },
        "shipping": {
          "type": "accordion",
          "settings": {
            "heading": "Shipping",
            "content": "<p>Free standard shipping on orders over €55. Dispatched within 24 hours from Seville, Spain.</p>"
          }
        },
        "returns": {
          "type": "accordion",
          "settings": {
            "heading": "Returns",
            "content": "<p>30-day no-hassle return policy. Items must be in original condition and packaging.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant-picker",
        "quantity",
        "buy-buttons",
        "trust-badges",
        "inventory",
        "description",
        "whats-included",
        "specifications",
        "shipping",
        "returns"
      ],
      "settings": {
        "media_layout": "stacked",
        "media_ratio": "portrait",
        "sticky_info": true,
        "color_scheme": "scheme_1"
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h3",
        "products_to_show": 4,
        "columns": 4,
        "color_scheme": "scheme_1"
      }
    }
  },
  "order": [
    "main",
    "related"
  ]
}
